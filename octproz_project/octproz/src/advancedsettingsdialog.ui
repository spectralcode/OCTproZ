              </property>
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Half-width of the rolling average window in samples (total window = 2*value+1).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
