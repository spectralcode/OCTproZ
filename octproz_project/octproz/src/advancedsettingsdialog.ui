              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;EMA: Weighted average where older B-scans fade exponentially. Memory-efficient (1 frame that is updated continuously). &lt;br&gt; Circular Buffer: Exact average of last N B-scans, uses more memory (Buffer of N frames is updated continuously).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <item>
               <property name="text">
                <string>Exponential Moving Average</string>
